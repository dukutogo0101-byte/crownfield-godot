extends SceneTree
# Actual default-map games, not direct calls to the AI planner. The fixture was
# generated by the previous published kernel at tick 2880 (480 days).
const Core = preload("res://core/simulation.gd")
var failures: Array = []
var checks: int = 0
func _initialize() -> void:
	call_deferred("run")
func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures.append(label); printerr("FAIL ", label)
func metrics(sim) -> Dictionary:
	var bases: Array = [0, 0, 0, 0]
	var population: Array = [0, 0, 0, 0]
	var jobs: Dictionary = {}
	for base in sim.state.bases: bases[base.team] += 1
	for team in range(4): population[team] = sim.population(team)
	for unit in sim.state.units:
		if unit.team == 0: continue
		var job: String = str(unit.team) + ":" + unit.get("ai_job", "none")
		jobs[job] = int(jobs.get(job, 0)) + 1
	return {"tick": sim.state.tick, "bases": bases, "population": population, "jobs": jobs}
func run_case(name: String, sim, ticks: int, commands: Array = []) -> Dictionary:
	var start: Dictionary = metrics(sim)
	var peak: Array = start.bases.duplicate()
	var samples: Array = [start]
	var began: int = Time.get_ticks_msec()
	for _tick in range(ticks):
		sim.step(commands); commands = []
		var counts: Array = [0, 0, 0, 0]
		for base in sim.state.bases: counts[base.team] += 1
		for team in range(4): peak[team] = maxi(peak[team], counts[team])
		if sim.state.tick % 120 == 0:
			samples.append(metrics(sim))
			print("AI PROGRESS ", name, " ", JSON.stringify(samples[-1]))
		if sim.state.result != "playing": break
	var end: Dictionary = metrics(sim)
	if samples[-1].tick != end.tick: samples.append(end)
	return {"name": name, "start": start, "end": end, "peak_bases": peak, "samples": samples, "outcome": sim.state.result, "final_hash": sim.state_hash(), "elapsed_ms": Time.get_ticks_msec() - began}
func run() -> void:
	var sim = Core.new()
	var saved: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/pre_ai_fix_stalemate.json"))
	check(sim.restore(saved), "previously stalled saved game loads")
	var resumed: Dictionary = run_case("resume_stalled_day_480", sim, 600)
	var expanded: int = 0
	for team in range(1, 4):
		if resumed.peak_bases[team] > resumed.start.bases[team] + 2: expanded += 1
	check(expanded >= 2, "at least two stalled enemies restart substantial development")
	check(resumed.peak_bases[1] > 7, "old save no longer imposes seven-village ceiling")
	sim = Core.new(); sim.new_game()
	var fresh: Dictionary = run_case("fresh_player_housing", sim, 1200, [sim.issue("develop", [4]), sim.issue("initial_order", [], -1, {"order": "develop"})])
	check(fresh.peak_bases[1] > 7 and fresh.peak_bases[3] > 7, "fresh enemies develop well past former limit")
	check(fresh.end.tick >= 600, "fresh scenario covers at least 100 days")
	var report: Dictionary = {"checks": checks, "passed": checks - failures.size(), "failed": failures, "scope": "Godot headless default map and old saved stalemate; not mobile browser or subjective difficulty testing", "cases": [resumed, fresh]}
	var file = FileAccess.open("res://tests/ai_progression_results.json", FileAccess.WRITE)
	file.store_string(JSON.stringify(report, "\t"))
	print("AI PROGRESSION ", checks - failures.size(), "/", checks)
	quit(0 if failures.is_empty() else 1)
